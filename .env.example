# .env.example
# Copy this file to .env and replace the placeholders with your actual GCP values.
# DO NOT commit the .env file to version control.

# The Google Cloud Project ID where BigQuery and GCS reside
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# The BigQuery dataset to use for Verity tables (must be created beforehand)
VERITY_DATASET="verity_dev"

# The GCS bucket used to stage local CSVs before loading into BigQuery
VERITY_GCS_STAGING_BUCKET="your-gcs-bucket-name"

# (Optional) Path to your Service Account JSON key if you are not using gcloud ADC
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/sa-key.json"

# (Optional) Verity Engine selection (datafusion | bigquery)
# VERITY_ENGINE="datafusion"
